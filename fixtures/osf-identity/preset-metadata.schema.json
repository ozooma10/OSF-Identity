{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osf-identity:preset-metadata:v1",
  "title": "OSF Identity preset dependency metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requires"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugins",
        "assets"
      ],
      "properties": {
        "plugins": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^\\\\/:]+\\.[eE][sS][mMpPlL]$"
          }
        },
        "assets": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
