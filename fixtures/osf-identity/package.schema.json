{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osf-identity:package:v1",
  "title": "OSF Identity appearance pack manifest",
  "description": "Optional pack manifest. The containing folder name is always the pack ID. Without assignments, presets are discovered from <OwningPlugin>/<localFormId>.npc. Explicit assignments use the same load-order-independent plugin-local identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "priority"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "priority": {
      "type": "integer",
      "minimum": -1000000,
      "maximum": 1000000
    },
    "requires": {
      "$ref": "#/$defs/requirements"
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "preset",
          "scope"
        ],
        "properties": {
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plugin",
              "localFormId"
            ],
            "properties": {
              "plugin": {
                "$ref": "#/$defs/plugin"
              },
              "localFormId": {
                "type": "string",
                "pattern": "^(?:[0-9A-Fa-f]{1,6}|0[0-9A-Fa-f]{6}|00[0-9A-Fa-f]{6})$"
              }
            }
          },
          "preset": {
            "type": "string",
            "pattern": "\\.[nN][pP][cC]$"
          },
          "scope": {
            "const": "faceAndBody"
          },
          "requires": {
            "$ref": "#/$defs/requirements"
          }
        }
      }
    }
  },
  "$defs": {
    "plugin": {
      "type": "string",
      "pattern": "^[^\\\\/:]+\\.[eE][sS][mMpPlL]$"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugins",
        "assets"
      ],
      "properties": {
        "plugins": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/plugin"
          }
        },
        "assets": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
