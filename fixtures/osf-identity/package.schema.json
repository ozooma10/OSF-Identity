{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osf-identity:package:v1",
  "title": "OSF Identity appearance pack manifest",
  "description": "Optional pack manifest. The containing folder name is always the pack ID. A pack without a package.json runs at priority 0 using flat EditorID filenames; add this file only to set a priority, share requires across presets, or use explicit assignments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "priority",
    "requires"
  ],
  "oneOf": [
    {
      "required": ["assignments"],
      "not": { "required": ["presetConvention"] }
    },
    {
      "required": ["presetConvention"],
      "not": { "required": ["assignments"] }
    }
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "priority": {
      "type": "integer",
      "minimum": -1000000,
      "maximum": 1000000
    },
    "requires": {
      "$ref": "#/$defs/requirements"
    },
    "presetConvention": {
      "const": "editorIdFilename"
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "preset",
          "scope"
        ],
        "properties": {
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "editorId"
            ],
            "properties": {
              "editorId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_]{1,128}$"
              }
            }
          },
          "preset": {
            "type": "string",
            "pattern": "\\.[nN][pP][cC]$"
          },
          "scope": {
            "const": "faceAndBody"
          },
          "requires": {
            "$ref": "#/$defs/requirements"
          }
        }
      }
    }
  },
  "$defs": {
    "plugin": {
      "type": "string",
      "pattern": "^[^\\\\/:]+\\.[eE][sS][mMpPlL]$"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugins",
        "assets"
      ],
      "properties": {
        "plugins": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/plugin"
          }
        },
        "assets": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
